#. Plugin Name of the plugin
#: oliforge-cf7-submission-guard.php
#: includes/class-oliforge-cf7sg-settings.php:82
msgid "OliForge CF7 Submission Guard"
msgstr "OliForge CF7 Submission Guard"

#. Description of the plugin
#: oliforge-cf7-submission-guard.php
msgid ""
"Configurable server-side submission validation and lightweight logging for "
"Contact Form 7."
msgstr ""
"Konfigurierbare serverseitige Validierung von Formularübermittlungen und "
"schlankes Logging für Contact Form 7."

#. Author of the plugin
#: oliforge-cf7-submission-guard.php
#: includes/class-oliforge-cf7sg-settings.php:390
#: includes/class-oliforge-cf7sg-settings.php:392
msgid "OliForge"
msgstr "OliForge"

