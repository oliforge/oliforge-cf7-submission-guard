#. Description of the plugin
#: oliforge-cf7-submission-guard.php
msgid ""
"Configurable server-side submission validation and lightweight logging for "
"Contact Form 7."
msgstr ""
"Validación configurable en el servidor de los envíos y registro ligero para "
"Contact Form 7."

