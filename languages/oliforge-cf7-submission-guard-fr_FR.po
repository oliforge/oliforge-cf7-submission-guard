#. Plugin Name of the plugin
#: oliforge-cf7-submission-guard.php
#: includes/class-oliforge-cf7sg-settings.php:82
msgid "OliForge CF7 Submission Guard"
msgstr "OliForge CF7 Submission Guard"

#. Description of the plugin
#: oliforge-cf7-submission-guard.php
msgid ""
"Configurable server-side submission validation and lightweight logging for "
"Contact Form 7."
msgstr ""
"Validation côté serveur configurable des soumissions et journalisation "
"légère pour Contact Form 7."

#. Author of the plugin
#: oliforge-cf7-submission-guard.php
#: includes/class-oliforge-cf7sg-settings.php:390
