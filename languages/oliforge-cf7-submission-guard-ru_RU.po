#. Plugin Name of the plugin
#: oliforge-cf7-submission-guard.php
#: includes/class-oliforge-cf7sg-settings.php:82
msgid "OliForge CF7 Submission Guard"
msgstr "OliForge CF7 Submission Guard"

#. Description of the plugin
#: oliforge-cf7-submission-guard.php
msgid ""
"Configurable server-side submission validation and lightweight logging for "
"Contact Form 7."
msgstr ""
"Настраиваемая серверная проверка отправок и облегчённое логирование для "
"Contact Form 7."

#. Author of the plugin
#: oliforge-cf7-submission-guard.php
#: includes/class-oliforge-cf7sg-settings.php:390
#: includes/class-oliforge-cf7sg-settings.php:392
msgid "OliForge"
msgstr "OliForge"

#: includes/class-oliforge-cf7sg-forms.php:35
#, php-format
msgid "Form %s"
msgstr "Форма %s"

#: includes/class-oliforge-cf7sg-plugin.php:71
msgid ""
"OliForge CF7 Submission Guard requires Contact Form 7 to be installed and "
"active."
msgstr ""
"Для работы OliForge CF7 Submission Guard требуется установленный и активный "
"плагин Contact Form 7."

