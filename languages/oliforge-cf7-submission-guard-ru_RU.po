msgid "Mode"
msgstr "Режим"

#: includes/class-oliforge-cf7sg-settings.php:446
msgid "Enforce"
msgstr "Принудительно"

#: includes/class-oliforge-cf7sg-settings.php:447
msgid "Generic error field"
msgstr "Поле для общих ошибок"

#: includes/class-oliforge-cf7sg-settings.php:447
msgid "Used when a matched rule has no field of its own to attach the error to (e.g. rate limiting)."
msgstr "Используется, когда у сработавшего правила нет собственного поля для привязки ошибки (например, при ограничении частоты)."

#: includes/class-oliforge-cf7sg-settings.php:452
msgid "Message field"
msgstr "Поле сообщения"

