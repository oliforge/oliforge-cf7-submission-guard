msgstr "Записывать успешные отправки"

#: includes/class-oliforge-cf7sg-settings.php:443
msgid "IP storage"
msgstr "Хранение IP"

#: includes/class-oliforge-cf7sg-settings.php:446
msgid "Anonymized"
msgstr "Анонимизировано"

#: includes/class-oliforge-cf7sg-settings.php:447
