msgid "@ detected"
msgstr "Обнаружен символ @"

#: includes/class-oliforge-cf7sg-settings.php:670
msgid "Email pattern detected"
msgstr "Обнаружен шаблон email"

#: includes/class-oliforge-cf7sg-settings.php:671
