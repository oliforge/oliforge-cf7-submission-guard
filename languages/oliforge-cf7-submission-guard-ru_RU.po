msgstr "Используется для обнаружения повторных отправок."

#: includes/class-oliforge-cf7sg-settings.php:455
msgid "Email field"
msgstr "Поле email"

#: includes/class-oliforge-cf7sg-settings.php:459
msgid "Country field"
msgstr "Поле страны"

#: includes/class-oliforge-cf7sg-settings.php:465
msgid "Field length rules"
msgstr "Правила длины полей"

#: includes/class-oliforge-cf7sg-settings.php:466
msgid "Add any CF7 field name to enforce a minimum and/or maximum character length (0 = no limit)."
msgstr "Добавьте любое имя поля CF7, чтобы задать минимальную и/или максимальную длину (0 — без ограничения)."

#: includes/class-oliforge-cf7sg-settings.php:471
msgid "Field name"
msgstr "Имя поля"

#: includes/class-oliforge-cf7sg-settings.php:472
msgid "Min length"
msgstr "Мин. длина"

#: includes/class-oliforge-cf7sg-settings.php:473
msgid "Max length"
msgstr "Макс. длина"

