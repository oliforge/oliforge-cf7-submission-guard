msgstr "Обнаружен HTML"

#: includes/class-oliforge-cf7sg-settings.php:672
msgid "BBCode detected"
msgstr "Обнаружен BBCode"

#: includes/class-oliforge-cf7sg-settings.php:673
msgid "Forbidden content"
msgstr "Запрещённое содержимое"

#: includes/class-oliforge-cf7sg-settings.php:674
msgid "Invalid country"
msgstr "Недопустимая страна"

#: includes/class-oliforge-cf7sg-settings.php:675
msgid "Invalid select option"
msgstr "Недопустимая опция select"

#: includes/class-oliforge-cf7sg-settings.php:676
msgid "Blocked email domain"
msgstr "Заблокированный домен email"

#: includes/class-oliforge-cf7sg-settings.php:678
msgid "Too fast"
msgstr "Слишком быстро"

#: includes/class-oliforge-cf7sg-settings.php:679
msgid "Duplicate"
msgstr "Дубликат"

#: includes/class-oliforge-cf7sg-settings.php:680
msgid "Consent missing"
msgstr "Согласие отсутствует"

#: includes/class-oliforge-cf7sg-settings.php:740
msgid ""
"Latest 200 events. Name and message contents are never stored; the email "
"address itself is never stored either, only its domain."
msgstr ""
"Последние 200 событий. Содержимое имени и сообщения никогда не сохраняется; "
"сам адрес email также не сохраняется — только его домен."

