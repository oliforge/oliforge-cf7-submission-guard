#: includes/class-oliforge-cf7sg-settings.php:754
msgid "Result"
msgstr "Результат"

#: includes/class-oliforge-cf7sg-settings.php:496
msgid "View full log"
msgstr "Переглянути весь журнал"

#: includes/class-oliforge-cf7sg-settings.php:517
msgid "General"
msgstr "Загальні"

#: includes/class-oliforge-cf7sg-settings.php:518
msgid "Forms"
msgstr "Форми"

#: includes/class-oliforge-cf7sg-settings.php:519
msgid "Content rules"
msgstr "Правила вмісту"

#: includes/class-oliforge-cf7sg-settings.php:520
msgid "Email domains"
msgstr "Домени email"

#: includes/class-oliforge-cf7sg-settings.php:521
msgid "Rate limit & timing"
msgstr "Обмеження частоти та таймінг"

#: includes/class-oliforge-cf7sg-settings.php:522
msgid "Consent"
msgstr "Згода"

#: includes/class-oliforge-cf7sg-settings.php:523
msgid "Logging"
msgstr "Логування"

#: includes/class-oliforge-cf7sg-settings.php:524
msgid "Error messages"
msgstr "Повідомлення про помилки"

#: includes/class-oliforge-cf7sg-settings.php:528
msgid "Country"
msgstr "Країна"

#: includes/class-oliforge-cf7sg-settings.php:537
msgid ""
"Server-side submission rules for Contact Form 7. Field names must match the "
"CF7 form-tag names."
msgstr ""
"Серверні правила надсилання для Contact Form 7. Імена полів мають збігатися "
"з іменами тегів форми CF7."

#: includes/class-oliforge-cf7sg-settings.php:550
msgid "Enable protection"
msgstr "Увімкнути захист"

#: includes/class-oliforge-cf7sg-settings.php:552
msgid "Mode"
msgstr "Режим"

#: includes/class-oliforge-cf7sg-settings.php:552
msgid "Enforce"
msgstr "Примусово"

#: includes/class-oliforge-cf7sg-settings.php:557
msgid "No Contact Form 7 forms were found."
msgstr "Форми Contact Form 7 не знайдено."

#: includes/class-oliforge-cf7sg-settings.php:562
msgid "Protect this form"
msgstr "Захищати цю форму"

#: includes/class-oliforge-cf7sg-settings.php:565
msgid "Name field"
msgstr "Поле імені"

#: includes/class-oliforge-cf7sg-settings.php:566
msgid "Maximum name length"
msgstr "Максимальна довжина імені"

#: includes/class-oliforge-cf7sg-settings.php:569
msgid "Message field"
msgstr "Поле повідомлення"

#: includes/class-oliforge-cf7sg-settings.php:570
msgid "Minimum message length"
msgstr "Мінімальна довжина повідомлення"

#: includes/class-oliforge-cf7sg-settings.php:571
msgid "Maximum message length (0 = disabled)"
msgstr "Максимальна довжина повідомлення (0 — вимкнено)"

#: includes/class-oliforge-cf7sg-settings.php:574
msgid "Email field"
msgstr "Поле email"

#: includes/class-oliforge-cf7sg-settings.php:575
msgid "Consent field"
msgstr "Поле згоди"

#: includes/class-oliforge-cf7sg-settings.php:576
msgid "Generic error field"
msgstr "Поле для загальних помилок"

#: includes/class-oliforge-cf7sg-settings.php:576
msgid ""
"Used when a matched rule has no field of its own to attach the error to "
"(e.g. rate limiting, too-fast submission)."
msgstr ""
"Використовується, коли спрацьоване правило не має власного поля для "
"прив'язки помилки (наприклад, при обмеженні частоти або надто швидкому "
"надсиланні)."

#: includes/class-oliforge-cf7sg-settings.php:595
msgid "Block URLs/domains"
msgstr "Блокувати посилання/домени"

#: includes/class-oliforge-cf7sg-settings.php:596
msgid "Block @ character"
msgstr "Блокувати символ @"

#: includes/class-oliforge-cf7sg-settings.php:597
msgid "Block email patterns"
msgstr "Блокувати шаблони email"

#: includes/class-oliforge-cf7sg-settings.php:598
msgid "Block HTML tags"
msgstr "Блокувати HTML-теги"

#: includes/class-oliforge-cf7sg-settings.php:599
msgid "Block BBCode-like markup"
msgstr "Блокувати розмітку на кшталт BBCode"

#: includes/class-oliforge-cf7sg-settings.php:601
msgid "Reject select fields whose value isn't one of their own options"
msgstr ""
"Відхиляти select-поля, якщо значення не входить до їх власного списку опцій"

#: includes/class-oliforge-cf7sg-settings.php:601
msgid ""
"Applies automatically to every [select] field on a protected form, "
"independent of the fields checked above — catches scripted submissions that "
"bypass the dropdown."
msgstr ""
"Застосовується автоматично до всіх полів [select] на захищеній формі, "
"незалежно від полів, позначених вище — виявляє скриптові надсилання, що "
"обходять випадний список."

#: includes/class-oliforge-cf7sg-settings.php:604
msgid "Max digits % (0 = disabled)"
msgstr "Макс. % цифр (0 — вимкнено)"

#: includes/class-oliforge-cf7sg-settings.php:605
msgid "Max uppercase % (0 = disabled)"
msgstr "Макс. % великих літер (0 — вимкнено)"

#: includes/class-oliforge-cf7sg-settings.php:607
msgid "Forbidden words/phrases, one per line"
msgstr "Заборонені слова/фрази, по одному в рядку"

#: includes/class-oliforge-cf7sg-settings.php:611
msgid "Blocked domains"
msgstr "Заблоковані домени"

#: includes/class-oliforge-cf7sg-settings.php:611
msgid "One per line. Subdomains are blocked too."
msgstr "По одному в рядку. Піддомени також блокуються."

#: includes/class-oliforge-cf7sg-settings.php:616
msgid "Allowed values"
msgstr "Дозволені значення"

#: includes/class-oliforge-cf7sg-settings.php:616
msgid ""
"One per line. If empty, the plugin validates against the CF7 select tag "
"values when available."
msgstr ""
"По одному в рядку. Якщо поле порожнє, плагін перевіряє за значеннями тега "
"select CF7, якщо вони доступні."

#: includes/class-oliforge-cf7sg-settings.php:621
msgid "Enable IP rate limiting"
msgstr "Увімкнути обмеження частоти за IP"

#: includes/class-oliforge-cf7sg-settings.php:623
msgid "Maximum attempts"
msgstr "Максимум спроб"

#: includes/class-oliforge-cf7sg-settings.php:624
msgid "Period, minutes"
msgstr "Період, хвилин"

#: includes/class-oliforge-cf7sg-settings.php:627
msgid "Enable minimum completion time"
msgstr "Увімкнути мінімальний час заповнення"

#: includes/class-oliforge-cf7sg-settings.php:628
msgid "Minimum seconds"
msgstr "Мінімум секунд"

#: includes/class-oliforge-cf7sg-settings.php:630
msgid "Block duplicate messages from same IP"
msgstr "Блокувати повторні повідомлення з одного IP"

#: includes/class-oliforge-cf7sg-settings.php:631
msgid "Duplicate window, minutes"
msgstr "Вікно перевірки дублікатів, хвилин"

#: includes/class-oliforge-cf7sg-settings.php:635
msgid "Require configured consent field"
msgstr "Вимагати налаштоване поле згоди"

#: includes/class-oliforge-cf7sg-settings.php:636
msgid "The consent field is selected separately for each protected form."
msgstr "Поле згоди вибирається окремо для кожної захищеної форми."

#: includes/class-oliforge-cf7sg-settings.php:640
msgid "Enable security logging"
msgstr "Увімкнути журнал безпеки"

#: includes/class-oliforge-cf7sg-settings.php:641
msgid "Log successful submissions"
msgstr "Записувати успішні надсилання"

#: includes/class-oliforge-cf7sg-settings.php:647
msgid "IP storage"
msgstr "Зберігання IP"

#: includes/class-oliforge-cf7sg-settings.php:650
msgid "Anonymized"
msgstr "Анонімізовано"

#: includes/class-oliforge-cf7sg-settings.php:651
msgid "Full IP"
msgstr "Повний IP"

#: includes/class-oliforge-cf7sg-settings.php:652
msgid "Do not store"
msgstr "Не зберігати"

#: includes/class-oliforge-cf7sg-settings.php:656
msgid "Retention, days"
msgstr "Зберігання, днів"

#: includes/class-oliforge-cf7sg-settings.php:658
msgid ""
"Name and message contents are never written to the plugin log. The submitted "
"email address itself is never stored either — only its domain (e.g. "
"\"example.com\"), to help spot patterns."
msgstr ""
"Вміст імені та повідомлення ніколи не записується в журнал плагіна. Сама "
"адреса email також не зберігається — лише її домен (наприклад, "
"«example.com»), щоб допомогти виявляти закономірності."

#: includes/class-oliforge-cf7sg-settings.php:665
msgid "Name too long"
msgstr "Ім'я задовге"

#: includes/class-oliforge-cf7sg-settings.php:666
msgid "Message too short"
msgstr "Повідомлення закоротке"

#: includes/class-oliforge-cf7sg-settings.php:667
msgid "Message too long"
msgstr "Повідомлення задовге"

#: includes/class-oliforge-cf7sg-settings.php:668
msgid "URL detected"
msgstr "Виявлено посилання"

#: includes/class-oliforge-cf7sg-settings.php:669
msgid "@ detected"
msgstr "Виявлено символ @"

#: includes/class-oliforge-cf7sg-settings.php:670
msgid "Email pattern detected"
msgstr "Виявлено шаблон email"

#: includes/class-oliforge-cf7sg-settings.php:671
msgid "HTML detected"
msgstr "Виявлено HTML"

#: includes/class-oliforge-cf7sg-settings.php:672
msgid "BBCode detected"
msgstr "Виявлено BBCode"

#: includes/class-oliforge-cf7sg-settings.php:673
msgid "Forbidden content"
msgstr "Заборонений вміст"

#: includes/class-oliforge-cf7sg-settings.php:674
msgid "Invalid country"
msgstr "Недопустима країна"

#: includes/class-oliforge-cf7sg-settings.php:675
msgid "Invalid select option"
msgstr "Недопустима опція select"

#: includes/class-oliforge-cf7sg-settings.php:676
msgid "Blocked email domain"
msgstr "Заблокований домен email"

#: includes/class-oliforge-cf7sg-settings.php:678
msgid "Too fast"
msgstr "Занадто швидко"

#: includes/class-oliforge-cf7sg-settings.php:679
msgid "Duplicate"
msgstr "Дублікат"

#: includes/class-oliforge-cf7sg-settings.php:680
msgid "Consent missing"
msgstr "Згода відсутня"

#: includes/class-oliforge-cf7sg-settings.php:740
msgid ""
"Latest 200 events. Name and message contents are never stored; the email "
"address itself is never stored either, only its domain."
msgstr ""
"Останні 200 подій. Вміст імені та повідомлення ніколи не зберігається; сама "
"адреса email також не зберігається — лише її домен."

#: includes/class-oliforge-cf7sg-settings.php:745
msgid "Clear all logs"
msgstr "Очистити весь журнал"

