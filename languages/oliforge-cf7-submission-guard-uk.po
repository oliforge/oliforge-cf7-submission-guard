#: includes/class-oliforge-cf7sg-settings.php:689
msgid "Blocked email domain"
msgstr "Заблокований домен email"

#: includes/class-oliforge-cf7sg-settings.php:691
msgid "Too fast"
msgstr "Занадто швидко"

#: includes/class-oliforge-cf7sg-settings.php:692
