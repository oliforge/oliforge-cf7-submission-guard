msgstr "Форма"

#: includes/class-oliforge-cf7sg-settings.php:756
msgid "Field"
msgstr "Поле"

#: includes/class-oliforge-cf7sg-settings.php:757
msgid "Email domain"
msgstr "Домен email"

#: includes/class-oliforge-cf7sg-settings.php:758
msgid "IP"
msgstr "IP"

#: includes/class-oliforge-cf7sg-settings.php:759
msgid "User agent"
msgstr "User Agent"

