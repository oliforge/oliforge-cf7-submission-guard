#: includes/class-oliforge-cf7sg-settings.php:539
msgid ""
"Server-side submission rules for Contact Form 7. Field names must match the "
"CF7 form-tag names."
msgstr ""
"Серверні правила надсилання для Contact Form 7. Імена полів мають збігатися "
"з іменами тегів форми CF7."

#: includes/class-oliforge-cf7sg-settings.php:552
msgid "Enable protection"
msgstr "Увімкнути захист"

#: includes/class-oliforge-cf7sg-settings.php:554
msgid "Mode"
msgstr "Режим"

#: includes/class-oliforge-cf7sg-settings.php:554
msgid "Enforce"
msgstr "Примусово"

